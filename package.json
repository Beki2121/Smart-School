{
  "name": "smartschool-sims",
  "version": "0.1.0",
  "private": true,
  "description": "Bilingual, tenant-aware SmartSchool SIMS Release 1 foundation",
  "workspaces": [
    "backend",
    "frontend"
  ],
  "scripts": {
    "dev": "concurrently -k -n API,WEB -c blue,green \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "npm run dev --workspace backend",
    "dev:web": "npm run dev --workspace frontend",
    "build": "npm run build --workspace frontend",
    "test": "npm run test --workspace backend",
    "lint": "npm run lint --workspace backend && npm run lint --workspace frontend",
    "db:migrate": "npm run db:migrate --workspace backend",
    "db:rollback": "npm run db:rollback --workspace backend",
    "db:seed": "npm run db:seed --workspace backend"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  },
  "engines": {
    "node": ">=20"
  }
}
