NODE_ENV=development
PORT=4000
WEB_ORIGIN=http://localhost:5174
WEB_ALLOWED_ORIGINS=http://127.0.0.1:5174
JWT_ACCESS_SECRET=replace-with-at-least-32-random-characters
JWT_ACCESS_TTL=15m
# Dedicated 32-byte base64url key for protected student fields; keep stable and separate from JWT_ACCESS_SECRET.
SENSITIVE_DATA_KEY=
STORAGE_MODE=memory
VITE_API_BASE_URL=http://localhost:4000

# Use STORAGE_MODE=mysql for durable data. MAMP on Windows commonly uses port 3306.
DB_HOST=127.0.0.1
DB_PORT=3306
# Optional MariaDB/MySQL UNIX socket path (use instead of DB_HOST/DB_PORT when required by the host).
DB_SOCKET_PATH=
DB_USER=root
DB_PASSWORD=root
DB_NAME=smartschool_sims

# SMTP is required in production for self-service password recovery.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=berekethabtamu2121@gmail.com
SMTP_PASSWORD=dsya duux imvl jpua
SMTP_FROM=berekethabtamu2121@gmail.com

# Development-only account when STORAGE_MODE=memory
DEMO_LOGIN_EMAIL=admin@school.local
DEMO_LOGIN_PASSWORD=ChangeMe123!